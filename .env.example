# Environment Configuration for Factory Management System
# Copy this file to .env and update the values

# Database Configuration
# For SQLite (Local Development - recommended for testing):
DATABASE_URL=sqlite:///factory_management.db

# For PostgreSQL (Production):
# DATABASE_URL=postgresql://username:password@localhost:5432/factory_db

# Flask Configuration
SESSION_SECRET=dev-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL Connection Details (if using PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=factory_db

# Optional Email Configuration (SendGrid)
# SENDGRID_API_KEY=your-sendgrid-api-key-here
# FROM_EMAIL=your-email@company.com

# Optional SMS Configuration (Twilio)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Optional AI Features (OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here

# Company Information
COMPANY_NAME=Your Factory Name
COMPANY_ADDRESS=Your Factory Address
COMPANY_PHONE=+91-XXX-XXXXXXX
COMPANY_EMAIL=info@yourfactory.com
COMPANY_GST=XXAABCRXXXXMXZC